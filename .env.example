# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL (production) — RDS instance nocap-db in us-east-2
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@nocap-db.XXXXXXXXXXXX.us-east-2.rds.amazonaws.com:5432/nocap

# Leave unset or use the sqlite fallback for local development:
# DATABASE_URL=sqlite:///./nocap_local.db

# ---------------------------------------------------------------------------
# AWS credentials
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=us-east-2

# ---------------------------------------------------------------------------
# S3
# ---------------------------------------------------------------------------
S3_BUCKET_NAME=your-nocap-s3-bucket-name

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Set to "development" locally, "production" on EC2.
APP_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
