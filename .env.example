NOCAP_MODE=fixture
NOCAP_API=http://localhost:8000
# Sepolia credentials belong only on the API host; see README for optional P7.
# Opt in on the dashboard only after the API owner configures Sepolia anchoring:
NOCAP_ENABLE_ANCHOR=0
# On the API host only, in its private .env (values intentionally omitted):
# SEPOLIA_RPC=
# SEPOLIA_KEY=
# SEPOLIA_THROWAWAY=1

# Full-stack dashboard/API base (see docs/FULLSTACK.md).
# NOCAP_TOKEN=                  # local server-only workspace token
NOCAP_SERVICE_DEMO=0
NOCAP_BACKEND_MODE=demo
NOCAP_STORAGE=local
# DATABASE_URL=postgresql+psycopg://<app-user>:<password>@<host>:5432/<db>?sslmode=verify-full&sslrootcert=/run/certs/global-bundle.pem
# S3_BUCKET=
AWS_REGION=us-east-2
# NOCAP_SIGNING_PLUGIN=team_signing_adapter:verify_record
# NOCAP_VERIFIER_PLUGIN=verifier:verify
# NOCAP_DEVICE_TOKEN=           # on a device only, never on dashboard

# Optional explicit single source shown in Settings (public device ID, never a token).
# NOCAP_DEVICE_ID=your-enrolled-device-id

# Verifier configuration
OPENAI_API_KEY=
NOCAP_MODEL=gpt-4.1-mini
# Optional service credentials:
COURTLISTENER_API_TOKEN=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NOCAP_CONTACT_EMAIL=

# Select openai or luminal (default: openai)
NOCAP_PROVIDER=openai
LUMINAL_API_KEY=
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
