  "components": {
    "schemas": {
      "Body_ingest_captures_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "record": {
            "type": "string",
            "maxLength": 16384,
            "title": "Record"
          }
        },
        "type": "object",
        "required": [
          "file",
          "record"
        ],
        "title": "Body_ingest_captures_post"
      },
      "Body_verify_verify_file_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_verify_verify_file_post"
      },
      "CommentIn": {
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "body"
        ],
        "title": "CommentIn"
      },
      "DeviceIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "location": {
            "type": "string",
            "maxLength": 240,
            "title": "Location",
            "default": ""
          },
          "public_key": {
            "type": "string",
            "maxLength": 4096,
            "title": "Public Key",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DeviceIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Heartbeat": {
        "properties": {
          "firmware": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Firmware"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "firmware"
        ],
        "title": "Heartbeat"
      },
      "MemberIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "reviewer",
              "collaborator"
            ],
            "title": "Role",
            "default": "collaborator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "MemberIn"
      },
      "ReportIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text"
          },
          "capture_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Capture Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ReportIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
